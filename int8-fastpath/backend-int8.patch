+                (int) ggml_is_contiguous(t), (int) (t->src[0] ? ggml_is_contiguous(t->src[0]) : -1));
+            std::lock_guard<std::mutex> lock(mtx);
+            int n = ++seen[key];
+            if (n <= 2) std::fprintf(stderr, "KUNLUN SUPDIAG cpu: %s name=%s hit=%d\n", key, t->name, n);
