+bool moe_i8_matmul(int id, void * y, const void * w_i8, const float * scales, const void * x, int k, int n) {
+    static xdnn::Context * moe_ctx[2] = {nullptr, nullptr};
+    if (id < 0 || id > 1) return false;
+    select(id);   /* the vendor API targets the CURRENT device, not the Context's */
+    if (!moe_ctx[id]) {
+        moe_ctx[id] = new xdnn::Context(xdnn::Device(xdnn::kXPU1, id));
