+    auto & fn = *program;
+    select(id); load_kernel(fn, "kunlun-elementwise-add3", id);
+    if (!y0) y0 = (void *) a0;
+    if (!y1) y1 = (void *) a1;
+    if (!y2) y2 = (void *) a2;
