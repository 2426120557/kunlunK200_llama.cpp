+/* add3v2：与 elementwise_add3 同签名，但把每段 (rows,width,bias) 打包成 1 个 int。
+ * 参数区 9*8 + 3*4 = 84 B；空段由调用方填成有效设备指针，rows=0 时 kernel 跳过。 */
+static int add3_pack_cfg(int rows, int width, int bias) {
+    return ((bias & 1) << 30) | ((width & 0x3ffff) << 12) | (rows & 0xfff);
+}
+void elementwise_add3v2(Kernel & kernel, int id,
+                      void * y0, const void * a0, const void * b0, int rows0, int width0, int bias0,
+                      void * y1, const void * a1, const void * b1, int rows1, int width1, int bias1,
+                      void * y2, const void * a2, const void * b2, int rows2, int width2, int bias2) {
+    std::lock_guard<std::recursive_mutex> lock(mutex);
+    require(rows0 >= 0 && rows1 >= 0 && rows2 >= 0);
+    require(y0 && a0 && b0 && y1 && a1 && b1 && y2 && a2 && b2);
+    require(kernel.impl_->id == -1 || kernel.impl_->id == id);
+    kernel.impl_->id = id;
+    static Kernel::Impl * cache[2] = {nullptr, nullptr};
+    Kernel::Impl * & program = cache[id & 1];
+    if (!program) program = new Kernel::Impl{};
+    auto & fn = *program;
+    select(id); load_kernel(fn, "kunlun-elementwise-add3v2", id);
+    int c0 = add3_pack_cfg(rows0, width0, bias0);
+    int c1 = add3_pack_cfg(rows1, width1, bias1);
+    int c2 = add3_pack_cfg(rows2, width2, bias2);
+    /* 原地别名快照：与 elementwise() 完全相同，只是每段各用一块独立 buffer。
+       默认流保序，KUNLUN_ALIAS_NOWAIT=1 时原版也不做全设备 wait，这里保持一致。 */
+    void * ya[3] = {y0, y1, y2};
+    const void * aa[3] = {a0, a1, a2};
+    const void * bb[3] = {b0, b1, b2};
+    const int rr[3] = {rows0, rows1, rows2};
+    const int ww[3] = {width0, width1, width2};
+    const int biasv[3] = {bias0, bias1, bias2};
+    static void * snap[2][3] = {{nullptr, nullptr, nullptr}, {nullptr, nullptr, nullptr}};
+    static size_t snap_cap[2][3] = {{0, 0, 0}, {0, 0, 0}};
+    for (int i = 0; i < 3; ++i) {
+        if (rr[i] <= 0 || (ya[i] != aa[i] && ya[i] != bb[i])) continue;
+        size_t elems = (size_t) rr[i] * ww[i];
+        if (ya[i] == bb[i] && biasv[i]) elems = (size_t) ww[i];
+        const size_t bytes = elems * 4;
+        void * & dst = snap[id & 1][i];
+        size_t & cap = snap_cap[id & 1][i];
+        if (cap < bytes) {
+            if (dst) release(id, dst, cap);
+            dst = allocate(id, bytes);
+            cap = bytes;
+        }
+        require(dst);
+        copy_rows(kernel, id, dst, ya[i], (int) elems, 1, (int) elems, 0);
+        if (bb[i] == ya[i]) bb[i] = dst;
+        if (aa[i] == ya[i]) aa[i] = dst;
+    }
+    size_t offset = 0;
+    for (const void * arg : {(const void *) &ya[0], (const void *) &aa[0], (const void *) &bb[0],
+                             (const void *) &ya[1], (const void *) &aa[1], (const void *) &bb[1],
+                             (const void *) &ya[2], (const void *) &aa[2], (const void *) &bb[2]}) {
+        check(xpu_launch_argument_set(arg, 8, offset)); offset += 8;
+    }
+    for (const int * arg : {&c0, &c1, &c2}) {
+        check(xpu_launch_argument_set(arg, 4, offset)); offset += 4;
+    }
+    check(xpu_launch_config(launcher_clusters(), 8));
+    check(xpu_launch_async(fn.fn));
+    note_launch();
+    if (!async_ops()) check(xpu_wait());
+}
