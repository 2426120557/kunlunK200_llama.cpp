+    require(rows0 >= 0 && rows1 >= 0 && rows2 >= 0);
+    require(rows0 == 0 || (y0 && a0 && b0 && width0 > 0));
+    require(rows1 == 0 || (y1 && a1 && b1 && width1 > 0));
+    require(rows2 == 0 || (y2 && a2 && b2 && width2 > 0));
+    require(bias0 == 0 || bias0 == 1);
