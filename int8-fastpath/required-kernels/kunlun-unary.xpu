#include "xpu/kernel/cluster_header.h"
#include "xpu/kernel/simd.h"
#include "xpu/kernel/math.h"

// 逐元素一元算子：1=sigmoid, 2=softplus, 3=exp。y = f(a)，n 为元素数。
__global__ void kunlun_unary(float * y, const float * a, int n, int op) {
    __local__ float av[256];
    __local__ float ov[256];
    const int tid = cluster_id() * core_num() + core_id();
    const int threads = cluster_num() * core_num();
    for (int base = tid * 256; base < n; base += threads * 256) {
        int len = n - base;
        if (len > 256) len = 256;
        GM2LM(a + base, av, len * 4);
        for (int j = 0; j < len; ++j) {
            const float x = av[j];
            if (op == 1) {
                ov[j] = 1.0f / (1.0f + expf(-x));
            } else if (op == 2) {
                ov[j] = (x > 20.0f) ? x : log(1.0f + expf(x));
            } else {
                ov[j] = expf(x);
            }
        }
        LM2GM(ov, y + base, len * 4);
    }
}
